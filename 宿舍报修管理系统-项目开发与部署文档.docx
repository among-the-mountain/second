  <meta charset="utf-8" />
  <title>宿舍报修管理系统 - 项目开发与部署文档</title>
  <style>
    body { font-family: "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif; font-size:12pt; color:#000; line-height:1.6; }
    .title { font-size:18pt; font-weight:700; margin-bottom:6px; }
    .meta { margin-bottom:12px; }
    .section { font-size:14pt; font-weight:700; margin-top:18px; margin-bottom:6px; }
    .subsection { font-size:13pt; font-weight:700; margin-top:12px; margin-bottom:6px; }
    p { margin:6px 0; }
    ul { margin:6px 0 6px 20px; }
    .codebox { border:1px solid #000; background:#efefef; padding:8px; margin:8px 0; }
    pre { margin:0; font-family: "Consolas", "Courier New", monospace; font-size:10.5pt; white-space:pre-wrap; word-wrap:break-word; }
